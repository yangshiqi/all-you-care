# Supabase service role (绕过 RLS, 服务端用)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=
# Optional override for self-hosted / proxied Anthropic-compatible endpoints
# (e.g. https://api.example.com/anthropic). Leave empty for default api.anthropic.com.
ANTHROPIC_BASE_URL=

# Gmail IMAP (also used for SMTP preview-email send-from)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Preview email — when set, the publish step sends a copy of each new issue
# to this address via Gmail SMTP. Leave empty in prod to disable.
# Independent from `deliver` — does NOT touch subscriber broadcast.
PREVIEW_EMAIL_TO=

# Admin
ADMIN_TOKEN=
