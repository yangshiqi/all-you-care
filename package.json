{
  "name": "ainews",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "export": "next build && next export",
    "generate-static": "node scripts/generate-static-pages.js",
    "generate-static-advanced": "node scripts/generate-static-pages-advanced.js",
    "generate-static-incremental": "node scripts/generate-static-pages-advanced.js --incremental",
    "generate-static-force": "node scripts/generate-static-pages-advanced.js --force",
    "build-with-static": "npm run build && npm run generate-static",
    "build-with-static-advanced": "npm run build && npm run generate-static-advanced",
    "preview": "npm run build-with-static && npx serve out",
    "preview-advanced": "npm run build-with-static-advanced && npx serve out",
    "deploy": "bash scripts/deploy-static.sh",
    "deploy-vercel": "bash scripts/deploy-static.sh --vercel",
    "deploy-netlify": "bash scripts/deploy-static.sh --netlify",
    "preview-local": "bash scripts/deploy-static.sh --preview",
    "example": "node scripts/example-usage.js",
    "vercel-build": "npm run build-with-static-advanced",
    "vercel-deploy": "vercel --prod",
    "test-vercel": "node scripts/test-vercel-deployment.js",
    "test-build": "bash scripts/test-build.sh"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.76.1",
    "@tanstack/react-query": "^5.90.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.6.0",
    "lucide-react": "^0.548.0",
    "next": "16.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^16.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
